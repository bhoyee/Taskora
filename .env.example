# Copy this file to .env and fill in real values.
# Do not commit .env.

App__PublicBaseUrl=http://localhost:5173
App__TimeZoneId=Europe/London

Database__Provider=Sqlite
Database__EnsureCreatedOnStartup=false
Database__ApplyMigrationsOnStartup=false
ConnectionStrings__TodoApp=Data Source=todoapp.db

# Neon PostgreSQL production example:
# Database__Provider=Postgres
# Database__EnsureCreatedOnStartup=false
# Database__ApplyMigrationsOnStartup=true
# ConnectionStrings__TodoApp=Host=your-neon-host.neon.tech;Port=5432;Database=neondb;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# DemoData seeds a workspace for LOCAL DEVELOPMENT ONLY (always on in the
# Development environment regardless of this flag). Never enable this in a
# production environment that already has real accounts/data - it uses fixed
# ids and will silently overwrite an existing account's email if one already
# occupies that id (this happened once - see PublicDemo below for the safe,
# fully separate alternative used for the live "View demo" button).
DemoData__SeedOnStartup=false

# PublicDemo seeds a completely separate demo workspace and four role
# personas (all emails prefixed "demo-", all ids in their own namespace) for
# the public "View demo" landing-page login. Safe to enable in production -
# it never touches any id DemoData/DevelopmentDataSeeder creates.
PublicDemo__SeedOnStartup=false
# Wipes and re-seeds just the public demo workspace's content (projects/
# tasks/todos/routine/invitation) on a timer, so the public logins stay
# clean. Leave disabled unless SeedOnStartup above is also enabled.
PublicDemo__ResetScheduler__Enabled=false
PublicDemo__ResetScheduler__IntervalHours=24

Operations__Logs__RetentionDays=30
Operations__Logs__MaxEntries=200
Operations__Logs__FileEnabled=true
Operations__Logs__Directory=App_Data/logs
Operations__Backups__Enabled=true
Operations__Backups__Directory=App_Data/backups
Operations__Backups__RetentionDays=7
Operations__Backups__IntervalHours=24
Operations__Backups__RunOnStartup=true

Notifications__Scheduler__Enabled=true
Notifications__Scheduler__IntervalMinutes=1440

Authentication__Mode=AppToken
Authentication__Authority=
Authentication__Audience=todoapp-api

Cors__AllowedOrigins__0=http://localhost:5173
# Vercel production example:
# Cors__AllowedOrigins__0=https://your-taskora-app.vercel.app

# Your real super admin email(s). The public demo's Super Admin persona
# (demo-superadmin@example.com) is always recognized automatically - it's
# hardcoded in SuperAdminAuthorization.cs, not configured here - and its
# actual admin powers are separately restricted so it can only ever act on
# the demo's own workspace, never a real one.
Administration__SuperAdminEmails__0=you@example.com

Email__Smtp__Enabled=false
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__UseSsl=true
Email__Smtp__Username=your-smtp-username
Email__Smtp__Password=your-smtp-password
Email__Smtp__FromAddress=no-reply@example.com
Email__Smtp__FromName=Taskora
